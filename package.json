{
	"name": "indiecorns",
	"version": "0.5.0",
	"description": "Indiecorns community CLI, local discovery worker and browser reader for member posts.",
	"type": "module",
	"homepage": "https://indiecorns.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/danielsinewe/indiecorns-cli.git"
	},
	"bugs": {
		"url": "https://github.com/danielsinewe/indiecorns-cli/issues"
	},
	"keywords": [
		"indiecorns",
		"cli",
		"agent",
		"codex",
		"indie-hackers",
		"onboarding"
	],
	"author": {
		"name": "Daniel Sinewe",
		"email": "hello@danielsinewe.com",
		"url": "https://danielsinewe.com"
	},
	"bin": {
		"indiecorns": "indiecorns/bin/indiecorns.mjs"
	},
	"files": [
		"CHANGELOG.md",
		"indiecorns/bin/indiecorns.mjs",
		"plugins/indiecorns",
		".agents/plugins/marketplace.json",
		"indiecorns/lib"
	],
	"license": "MIT",
	"engines": {
		"node": "^20.20.0 || >=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"cli": "node ./indiecorns/bin/indiecorns.mjs",
		"smoke": "node ./indiecorns/bin/indiecorns.mjs help --no-telemetry",
		"pack:check": "npm pack --dry-run",
		"test": "node --test tests/*.test.mjs && npm run smoke && npm run pack:check",
		"runtime:verify": "node scripts/verify-runtime.mjs"
	},
	"packageManager": "npm@12.2.1",
	"dependencies": {
		"parse5": "8.1.1",
		"posthog-node": "5.63.1",
		"robots-parser": "3.0.1"
	}
}
